# Local tooling only (written by `bunx convex dev`). The gateway itself runs on Convex.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Set these on the Convex deployment with `bunx convex env set NAME value`, never in the desktop app:
# SITE_URL=https://<deployment>.convex.site
# BETTER_AUTH_SECRET=<random 32 bytes>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NVIDIA_API_KEY=
# Optional; defaults 2 and 20.
# FREE_MAX_CONCURRENT=2
# FREE_REQUESTS_PER_MINUTE=20
